# ==========================================
# Discord Bot Configuration
# ==========================================
# Dapatkan dari Discord Developer Portal -> General Information & Bot tab
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_APPLICATION_ID=your_discord_application_id_here

# Opsional: Jika diisi, registrasi slash command akan langsung aktif di server ini (instant tanpa delay propagation global)
DISCORD_GUILD_ID=

# Database path (default: data/afk.sqlite)
DATABASE_PATH=data/afk.sqlite

# ==========================================
# AI Provider Selection
# ==========================================
# Pilihan: 'auto' (otomatis deteksi key), 'openai' (untuk Groq / OpenAI compatible), atau 'gemini'
AI_PROVIDER=auto

# ------------------------------------------
# Opsi 1: Groq / OpenAI-Compatible (Rekomendasi Llama 3.1)
# ------------------------------------------
# Dapatkan API Key Groq gratis di: https://console.groq.com/keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.1-8b-instant
# Temperature AI (0.0 - 1.0, default: 0.7 agar tidak halu dan tetap nyambung)
AI_TEMPERATURE=0.7

# ------------------------------------------
# Opsi 2: Google Gemini
# ------------------------------------------
# Dapatkan API Key di https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------
# Kustomisasi Kepribadian AI (Opsional)
# ------------------------------------------
# Kosongkan untuk menggunakan default kepribadian: Parodi anak Jaksel, sarkastik, to the point (1-3 kalimat) & anti-halu
# AI_SYSTEM_PROMPT="Kamu adalah bot Discord yang..."
