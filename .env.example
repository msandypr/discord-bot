# ==========================================
# Discord Bot Configuration
# ==========================================
# Dapatkan dari Discord Developer Portal -> General Information & Bot tab
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_APPLICATION_ID=your_discord_application_id_here

# Opsional: Jika diisi, registrasi slash command akan langsung aktif di server ini (instant tanpa delay propagation global)
DISCORD_GUILD_ID=

# Database path (default: data/afk.sqlite)
DATABASE_PATH=data/afk.sqlite

# ==========================================
# AI Provider Selection
# ==========================================
# Pilihan: 'auto' (otomatis deteksi key), 'gemini', atau 'openai' (untuk OpenAI & compatible)
AI_PROVIDER=auto

# ------------------------------------------
# Opsi 1: Google Gemini (Default)
# ------------------------------------------
# Dapatkan API Key di https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------
# Opsi 2: OpenAI & OpenAI-Compatible
# (DeepSeek, Groq, OpenRouter, Ollama, LM Studio, dll.)
# ------------------------------------------
# Jika menggunakan OpenAI Resmi:
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
#
# Jika menggunakan DeepSeek:
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=deepseek-chat
#
# Jika menggunakan Groq (Inferensi Ultra-Cepat & Gratis):
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...
# OPENAI_MODEL=llama-3.3-70b-versatile
#
# Jika menggunakan OpenRouter (Multi-model):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_MODEL=anthropic/claude-3.5-sonnet
#
# Jika menggunakan Local Ollama (Offline & Gratis):
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
