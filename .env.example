# ==========================================
# Discord Bot Configuration
# ==========================================
# Dapatkan dari Discord Developer Portal -> General Information & Bot tab
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_APPLICATION_ID=your_discord_application_id_here

# Opsional: Jika diisi, registrasi slash command akan langsung aktif di server ini (instant tanpa delay propagation global)
DISCORD_GUILD_ID=

# Database path (default: data/afk.sqlite)
DATABASE_PATH=data/afk.sqlite

# ==========================================
# AI Provider Selection
# ==========================================
# Pilihan: 'auto' (otomatis deteksi key), 'gemini', atau 'openai' (untuk OpenAI & compatible)
AI_PROVIDER=auto

# ------------------------------------------
# Opsi 1: Google Gemini (Default)
# ------------------------------------------
# Dapatkan API Key di https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------
# Opsi 2: OpenAI & OpenAI-Compatible
# (DeepSeek, Groq, OpenRouter, Ollama, LM Studio, dll.)
# ------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------
# Kustomisasi Kepribadian AI (Opsional)
# ------------------------------------------
# Kosongkan untuk menggunakan default kepribadian: Parodi, sarkastik, ceplas-ceplos & singkat (1-3 kalimat)
# AI_SYSTEM_PROMPT="Kamu adalah bot Discord yang..."
